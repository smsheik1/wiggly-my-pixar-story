{
  "name": "@wiggly/my-pixar-story-format",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "npm run test:app && npm run test:kit",
    "test:kit": "node --test tests/remotion.test.mjs",
    "test:app": "tsx tests/app/my-pixar-story-format.test.tsx && tsx tests/app/my-pixar-story/smoke.test.ts && tsx tests/app/my-pixar-story/stateMachine.test.ts && tsx tests/app/my-pixar-story/providers.test.ts && tsx tests/app/my-pixar-story/inspect.test.ts && tsx tests/app/my-pixar-story/render.test.tsx && tsx tests/app/my-pixar-story/scrapbook.test.tsx && tsx tests/app/my-pixar-story/ui.test.tsx",
    "typecheck:app": "tsc -p tsconfig.json",
    "build:renderer": "node build-renderer.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.16",
    "@radix-ui/react-label": "2.1.11",
    "@radix-ui/react-scroll-area": "1.2.11",
    "@radix-ui/react-slot": "1.2.5",
    "@remotion/bundler": "4.0.532",
    "@remotion/media": "4.0.532",
    "@remotion/player": "4.0.532",
    "@remotion/renderer": "4.0.532",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.546.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "remotion": "4.0.532",
    "tailwind-merge": "3.6.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "22.19.17",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "4.1.14",
    "tsx": "4.21.0",
    "typescript": "5.8.3"
  }
}
